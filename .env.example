# Ports here are offset from the jobell project's defaults (postgres 5432, redis 6379,
# backend 8000, frontend 3000) so both projects can run side by side without conflicts.
DATABASE_URL=postgresql+asyncpg://jobell:jobell@localhost:5433/jobell
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=http://localhost:3001

# Signs access tokens and OAuth state values — set a long random value in real envs
SECRET_KEY=dev-secret-key-change-me

# From a Google Cloud Console OAuth 2.0 client (APIs & Services > Credentials).
# GOOGLE_REDIRECT_URI must be registered there as an authorized redirect URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

# Where the Google OAuth callback redirects the browser after login
FRONTEND_URL=http://localhost:3001
